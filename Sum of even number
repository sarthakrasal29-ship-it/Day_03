#include <stdio.h>

int main() {
int n, i, sum = 0;

printf("Enter the limit: ");
scanf("%d", &n);

if (n < 1) {
    printf("Enter a positive number.\n");
} else {
    for (i = 1; i <= n; i++) {
        if (i % 2 == 0) {
            sum = sum + i;
        }
    }

    printf("Sum of even numbers = %d\n", sum);
}

return 0;

}
